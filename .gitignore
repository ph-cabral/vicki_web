# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — no se commitea ninguno, tampoco los .example.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: el cliente generado y la base local de desarrollo
/app/generated/prisma
*.db
*.db-journal
*.sqlite
*.sqlite3

# fotos y documentos de legajos (datos personales, no van al repo)
/employee
employees/
emp/
img_sorteo/
/documentos/
*.png
*.jpg
*.jpeg
*.svg
# ...salvo los assets de la app, que si son parte del codigo
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.svg
!app/icon.png
!app/apple-icon.png
!assets/**/*.png

# basura de compilacion / pruebas (ver limpieza 2026-08-15)
*.tmp
*.err
tscout.txt
_tmp_*
__test_*__*

# El DDL de sql/ NO se versiona: se corre a mano contra Postgres y los
# archivos se van borrando a medida que se aplican. No sacar esta regla.
sql/

# python (indicadores-api)
__pycache__/
*.pyc

# puente de telefonía: claves SIP de las extensiones (sólo en el server)
telefonia-gw/datos/
