generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["asistencia", "everwear", "fabrica", "preparado", "sistema"]
}

model personal {
  id        Int      @id @default(autoincrement())
  nombre    String
  dni       String?  @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  corte     corte[]

  @@schema("fabrica")
}

model manguera {
  id        Int      @id @default(autoincrement())
  codigo    String
  metros    Float    @default(0)
  ubicacion String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigo])
  @@schema("fabrica")
}

model corte {
  id          Int      @id @default(autoincrement())
  metros      Float
  fecha       DateTime @default(now())
  observacion String?
  personalId  Int?
  codigo      String
  trabajoId   Int?
  personal    personal? @relation(fields: [personalId], references: [id])
  trabajo     trabajo?  @relation(fields: [trabajoId], references: [id])

  @@index([fecha])
  @@index([personalId])
  @@index([trabajoId])
  @@schema("fabrica")
}

model picking_eventos {
  id             Int       @id @default(autoincrement())
  codigo         String    @db.VarChar(100)
  cantidad       Int
  picker_nombre  String    @db.VarChar(50)
  estado         String    @default("pendiente") @db.VarChar(20)
  respuesta_nota String?
  respondido_en  DateTime?
  creado_en      DateTime  @default(now())

  @@schema("preparado")
}

model picking_push_subs {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  @@schema("preparado")
}

model everwear_personal {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  area   String  @db.VarChar(50)
  activo Boolean @default(true)
  legajo legajo?

  @@map("personal")
  @@schema("everwear")
}

model chat_mensajes {
  id            Int       @id @default(autoincrement())
  picker_nombre String    @db.VarChar(100)
  mensaje       String
  respuesta     String?
  respondido    Boolean?  @default(false)
  creado_en     DateTime? @default(now()) @db.Timestamp(6)

  @@schema("preparado")
}

model legajo {
  id                     Int                      @id @default(autoincrement())
  codigo                 String?                  @unique
  estado                 String                   @default("ACTIVO") @db.VarChar(20)
  personalId             Int?                     @unique
  nombre                 String                   @db.VarChar(100)
  dni                    String?                  @unique @db.VarChar(20)
  cuil                   String?                  @db.VarChar(20)
  fechaNacimiento        DateTime?                @db.Date
  lugarNacimiento        String?                  @db.VarChar(150)
  nacionalidad           String?                  @default("Argentina") @db.VarChar(60)
  sexo                   String                   @db.VarChar(2)
  estadoCivil            String?                  @db.VarChar(20)
  altura                 Float?
  peso                   Float?
  manoHabil              String?                  @db.VarChar(20)
  telefonoFijo           String?                  @db.VarChar(40)
  telefonoCelular        String?                  @db.VarChar(40)
  emailPersonal          String?                  @db.VarChar(150)
  antecedentesPenales    Boolean                  @default(false)
  antecedentesDetalle    String?
  aceptaPsicotecnico     Boolean                  @default(false)
  calle                  String?                  @db.VarChar(150)
  numero                 String?                  @db.VarChar(20)
  piso                   String?                  @db.VarChar(10)
  depto                  String?                  @db.VarChar(10)
  codigoPostal           String?                  @db.VarChar(10)
  localidad              String?                  @db.VarChar(100)
  provincia              String?                  @db.VarChar(60)
  comprobanteUrl         String?
  ddjjConformidad        Boolean                  @default(false)
  fechaInicio            DateTime?                @db.Date
  fechaCese              DateTime?                @db.Date
  modalidadContrato      String?                  @db.VarChar(100)
  situacionRevista       String?                  @db.VarChar(20)
  regimen                String?                  @db.VarChar(40)
  convenio               String?                  @db.VarChar(100)
  categoria              String?                  @db.VarChar(100)
  puestoInterno          String?                  @db.VarChar(100)
  sector                 String?                  @db.VarChar(60)
  retribucionPactada     Float?
  modalidadLiquidacion   String?                  @db.VarChar(20)
  obraSocial             String?                  @db.VarChar(100)
  tipoServicio           String?                  @db.VarChar(100)
  actividadEconomica     String?                  @db.VarChar(100)
  domicilioExplotacion   String?                  @db.VarChar(200)
  claveAltaArca          String?                  @db.VarChar(40)
  fechaEnvioAlta         DateTime?
  banco                  String?                  @db.VarChar(40)
  bancoOtro              String?                  @db.VarChar(60)
  diaPago                Int?
  percibeSeguroDesempleo Boolean?                 @default(false)
  ddjjArt12              Boolean                  @default(false)
  tieneCargasFamilia     Boolean?                 @default(false)
  medioPagoAaff          String?                  @db.VarChar(40)
  medioPagoAaffOtro      String?                  @db.VarChar(100)
  estatura               Float?
  pesoSalud              Float?
  presionMin             Int?
  presionMax             Int?
  patologiaNervioso      Boolean                  @default(false)
  patologiaRespiratorio  Boolean                  @default(false)
  patologiaCirculatorio  Boolean                  @default(false)
  patologiaDigestivo     Boolean                  @default(false)
  patologiaRenal         Boolean                  @default(false)
  patologiaOseo          Boolean                  @default(false)
  patologiaSangre        Boolean                  @default(false)
  patologiaCancer        Boolean                  @default(false)
  patologiaCongenitas    Boolean                  @default(false)
  patologiaEndocrinas    Boolean                  @default(false)
  patologiaGinecologicas Boolean                  @default(false)
  patologiaEmbarazo      Boolean                  @default(false)
  patologiaOtras         Boolean                  @default(false)
  patologiaChagas        Boolean                  @default(false)
  observacionesSalud     String?
  numeroSolicitud        String?                  @db.VarChar(60)
  numeroPoliza           String?                  @db.VarChar(60)
  capitalAsegurado       Float?
  fechaIngresoEmpleo     DateTime?                @db.Date
  artCompania            String?                  @db.VarChar(80)
  artNumeroContrato      String?                  @db.VarChar(60)
  artCredencialEntregada Boolean                  @default(false)
  aceptaClausulas        Boolean                  @default(false)
  jurisdiccion           String                   @default("San Francisco, Córdoba") @db.VarChar(100)
  firmaEmpleado          String?
  fechaFirma             DateTime?                @db.Date
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  employeeNo             String?                  @unique @db.VarChar(50)
  personal               everwear_personal?       @relation(fields: [personalId], references: [id])
  antecedentesSrt        legajo_antecedente_srt[]
  beneficiarios          legajo_beneficiario[]
  equipos                legajo_equipo[]
  estudios               legajo_estudio[]
  familiares             legajo_familiar[]
  idiomas                legajo_idioma[]
  sectorId               Int?
  sectorRel              sector?   @relation(fields: [sectorId], references: [id])
  trabajos               trabajo[]
  usuario                usuario?
  anvizId                String?         @unique @db.VarChar(20)
  // Lugar físico (Oficina/Depósito/Fábrica/etc.) — ver modelo `lugar`.
  lugarId                Int?
  lugarRel               lugar?    @relation(fields: [lugarId], references: [id])
  // Convenio colectivo y categoría — ver modelos `convenio` / `convenio_categoria`.
  // Las columnas de texto convenio/categoria de arriba quedan como copia del
  // nombre elegido (las leen exports y consultas viejas); las escribe
  // resolverConvenio() en lib/rrhh/legajoService.ts.
  convenioId             Int?
  convenioRel            convenio? @relation(fields: [convenioId], references: [id])
  categoriaId            Int?
  categoriaRel           convenio_categoria? @relation(fields: [categoriaId], references: [id])
  @@index([estado])
  @@index([convenioId])
  @@schema("everwear")
}

// Catálogo de convenios colectivos y sus categorías. Cabecera + detalle, misma
// forma que area/sector: la categoría cuelga del convenio, así el selector del
// legajo no puede cruzar una categoría con el convenio equivocado.
// Se dan de alta desde la UI (botón "+" del selector de legajo).
// Ver sql/rrhh_convenio_categoria.sql — correr contra Postgres + `prisma db pull`
// antes de deployar.
model convenio {
  id         Int                  @id @default(autoincrement())
  nombre     String               @unique @db.VarChar(80)
  createdAt  DateTime             @default(now())
  categorias convenio_categoria[]
  legajos    legajo[]

  @@schema("everwear")
}

model convenio_categoria {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  convenioId Int
  createdAt  DateTime @default(now())
  convenio   convenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  legajos    legajo[]

  @@unique([nombre, convenioId])
  @@index([convenioId])
  @@schema("everwear")
}

model legajo_familiar {
  id              Int      @id @default(autoincrement())
  legajoId        Int
  parentesco      String   @db.VarChar(20)
  apellido        String   @db.VarChar(100)
  nombre          String   @db.VarChar(100)
  tipoDocumento   String   @default("DNI") @db.VarChar(10)
  numeroDocumento String   @db.VarChar(20)
  fechaNacimiento DateTime @db.Date
  nacionalidad    String   @default("Argentina") @db.VarChar(60)
  telefono        String?  @db.VarChar(40)
  ocupacion       String?  @db.VarChar(100)
  convive         Boolean  @default(false)
  legajo          legajo   @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_beneficiario {
  id              Int    @id @default(autoincrement())
  legajoId        Int
  apellidoNombre  String @db.VarChar(200)
  tipoDocumento   String @default("DNI") @db.VarChar(10)
  numeroDocumento String @db.VarChar(20)
  parentesco      String @db.VarChar(40)
  domicilio       String @db.VarChar(200)
  porcentaje      Float
  legajo          legajo @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_estudio {
  id          Int     @id @default(autoincrement())
  legajoId    Int
  nivel       String  @db.VarChar(20)
  institucion String  @db.VarChar(200)
  desde       String  @db.VarChar(10)
  hasta       String? @db.VarChar(10)
  titulo      String? @db.VarChar(200)
  enCurso     Boolean @default(false)
  legajo      legajo  @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_idioma {
  id        Int    @id @default(autoincrement())
  legajoId  Int
  idioma    String @db.VarChar(60)
  habla     String @db.VarChar(20)
  escritura String @db.VarChar(20)
  legajo    legajo @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_equipo {
  id            Int      @id @default(autoincrement())
  legajoId      Int
  tipo          String   @db.VarChar(30)
  marca         String   @db.VarChar(60)
  modelo        String   @db.VarChar(100)
  detalle       String?
  numeroSerie   String   @db.VarChar(80)
  fechaEntrega  DateTime @db.Date
  estado        String   @db.VarChar(10)
  observaciones String?
  legajo        legajo   @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_antecedente_srt {
  id            Int       @id @default(autoincrement())
  legajoId      Int
  descripcion   String    @db.VarChar(300)
  fecha         DateTime? @db.Date
  observaciones String?
  legajo        legajo    @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model asistencia_evento {
  id            BigInt    @id @default(autoincrement())
  device        String    @db.VarChar(50)
  employee_no   String    @db.VarChar(50)
  employee_name String?   @db.VarChar(200)
  event_time    DateTime  @db.Timestamptz(6)
  major         Int?
  minor         Int?
  card_no       String?   @db.VarChar(50)
  tipo          String?   @db.VarChar(20)
  job_id        BigInt?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([employee_no, event_time, device])
  @@index([employee_no, event_time])
  @@index([job_id])
  @@index([employee_no, event_time], map: "idx_evento_emp_fecha")
  @@index([job_id], map: "idx_evento_job")
  @@map("evento")
  @@schema("asistencia")
}

model asistencia_resumen_diario {
  id            BigInt    @id @default(autoincrement())
  employee_no   String    @db.VarChar(50)
  employee_name String?   @db.VarChar(200)
  fecha         DateTime  @db.Date
  check_in      DateTime? @db.Timestamptz(6)
  check_out     DateTime? @db.Timestamptz(6)
  minutos       Int?
  eventos_dia   Int?
  devices       String?
  job_id        BigInt?

  @@unique([employee_no, fecha])
  @@index([fecha])
  @@index([fecha], map: "idx_resumen_fecha")
  @@map("resumen_diario")
  @@schema("asistencia")
}

model job {
  id            BigInt    @id @default(autoincrement())
  start_ts      DateTime  @db.Timestamptz(6)
  end_ts        DateTime  @db.Timestamptz(6)
  status        String?   @default("running") @db.VarChar(20)
  eventos_raw   Int?
  eventos_ok    Int?
  resumen_filas Int?
  error_msg     String?
  duracion_seg  Float?    @db.Real
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("asistencia")
}

model user_id_registry {
  id           Int       @id @default(autoincrement())
  external_ref String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("everwear")
}

model area {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  sectores  sector[]

  @@schema("everwear")
}

model sector {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(80)
  areaId    Int
  createdAt DateTime  @default(now())
  area      area      @relation(fields: [areaId], references: [id])
  legajos   legajo[]
  trabajos  trabajo[]
  puestos   puesto[]

  @@unique([nombre, areaId])
  @@index([areaId])
  @@schema("everwear")
}

// Lugar físico de trabajo (Oficina, Depósito, Fábrica, etc.) — lista plana para
// selección rápida por legajo, distinta de área/sector (jerárquico). Se usa para
// agrupar el widget de "presentes" en /rrhh/asistencia. Ver sql/rrhh_lugar.sql
// — correr contra Postgres + `prisma db pull` antes de deployar.
model lugar {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  legajos   legajo[]

  @@schema("everwear")
}

// Tabla legada: los clientes ahora se leen en vivo de Magnus
// (MAGNUS_SITD.dbo.Clientes) desde /manguera/corte. Queda sin uso/relaciones.
model cliente {
  numero    Int      @id
  nombre    String   @db.VarChar(150)
  createdAt DateTime @default(now())

  @@schema("everwear")
}

model trabajo {
  id                  Int       @id @default(autoincrement())
  fechaPedido         DateTime  @default(now())
  pedidoTransferencia String?   @db.VarChar(60)
  ordenTrabajo        String?   @db.VarChar(60)
  prioridad           String?   @db.VarChar(20)
  producto            String?   @db.VarChar(80)
  cantidadAProducir   Float?
  observaciones       String?
  estado              String    @default("EN_PROCESO") @db.VarChar(20)
  legajoId            Int
  sectorId            Int?
  clienteNumero       Int?
  clienteNombre       String?   @db.VarChar(150)
  inicio              DateTime  @default(now())
  fin                 DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  legajo              legajo    @relation(fields: [legajoId], references: [id])
  sector              sector?   @relation(fields: [sectorId], references: [id])
  cortes              corte[]

  @@index([legajoId])
  @@index([estado])
  @@schema("fabrica")
}

// Una "ronda" = un sorteo completo. Guarda el plan de instancias (drag&drop)
// como JSON y agrupa a sus ganadores. Permite historial sin chocar entre sorteos.
model sorteo_ronda {
  id         Int            @id @default(autoincrement())
  titulo     String?
  estado     String         @default("armado") // armado | sorteando | cerrado
  instancias Json? // [{ orden, premios: [{ file, nombre, cantidad }] }]  (mejor→peor)
  createdAt  DateTime       @default(now())
  album      sorteo_album[]

  @@schema("everwear")
}

model sorteo_album {
  id        Int          @id @default(autoincrement())
  rondaId   Int
  ronda     sorteo_ronda @relation(fields: [rondaId], references: [id], onDelete: Cascade)
  orden     Int // 1..10 = posición/puesto dentro de la ronda
  instancia Int          @default(0) // a qué instancia del plan pertenece
  dni       String
  nombre    String
  marco     String       @default("oro") // oro | plata | bronce | celeste
  premio    String? // nombre del premio asignado
  premioImg String? // archivo en /public/premios
  createdAt DateTime     @default(now())

  @@unique([rondaId, orden])
  @@unique([rondaId, dni])
  @@schema("everwear")
}

// Faltantes: marca por renglón si había o no existencia (vista /deposito/faltantes).
model faltante_existencia {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @db.Date
  nroPedOrigen   Int      @map("nro_ped_origen")
  nroRengOrigen  Int      @map("nro_reng_origen")
  codArticulo    String?  @map("cod_articulo") @db.VarChar(50)
  existencia     Boolean?
  malFacturado   Boolean? @map("mal_facturado")
  cantidad       Float?
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@unique([fecha, nroPedOrigen, nroRengOrigen], name: "uniq_faltante")
  @@schema("preparado")
}

// Login de la app. Cada usuario se vincula a un legajo existente de everwear.
// El login es por DNI + contraseña; los permisos salen del sector (ver sector_permiso).
model usuario {
  id             Int       @id @default(autoincrement())
  legajoId       Int       @unique
  dni            String    @unique @db.VarChar(20)
  nombre         String    @db.VarChar(100)
  passwordHash   String
  rol            String    @default("USUARIO") @db.VarChar(20) // ADMIN | USUARIO
  sector         String?   @db.VarChar(80)
  // Código de vendedor en Magnus (MAGNUS_SITD.dbo.Ped_Usu_Arma.Usu_Arma_Codigo)
  // — para /ventas/vendedor (2026-08-14): un usuario
  // no-admin solo ve los clientes de SU vendedor. null = sin asignar (ve 0
  // clientes en esa vista hasta que un admin se lo asigne en
  // /admin/usuarios). Los ADMIN ignoran este campo (ven todos).
  vendedorCodigo Int?
  // Acceso total a /ventas/bulones (2026-08-28): true = este usuario ve el
  // 100% de la empresa en esa vista aunque no sea ADMIN (hay viajantes que
  // manejan la línea entera de bulonería, no una cartera). Sólo afecta a
  // /ventas/bulones; en /ventas/vendedor y el resto sigue viendo su cartera.
  // Lo asigna un admin en /admin/usuarios (antes era una lista de nombres
  // hardcodeada en lib/ventas/bulonesAcceso.ts).
  bulonesAccesoTotal Boolean @default(false)
  // Acceso a datos de ventas/BBDD desde el chat de Vicki (intent "ventas",
  // ver vicki_chat/app/nodes.py): true = puede pedirle a Vicki su
  // facturación/ranking. SIEMPRE filtrado por vendedorCodigo (ve solo lo
  // suyo) salvo que sea ADMIN o tenga bulonesAccesoTotal-style "toda la
  // empresa" — hoy no existe ese caso para ventas, se agrega si hace falta.
  // Sin vendedorCodigo asignado, aunque esté en true, no puede consultar nada
  // (mismo criterio que /ventas/vendedor: sin vendedor = cero datos).
  vickiVentasAcceso Boolean @default(false)
  // Acceso a datos de ASISTENCIA desde el chat de Vicki (intent "rrhh", ver
  // vicki_chat/app/asistencia_tools.py): faltas, feriados y horas extra.
  // OJO — a diferencia de vickiVentasAcceso, esto NO se filtra por persona:
  // quien lo tiene ve la asistencia de TODA la empresa (un dato de RRHH a
  // medias no sirve). Darlo sólo a RRHH. Ver lib/rrhh/vickiRrhhAcceso.ts.
  vickiRrhhAcceso Boolean @default(false)
  // Encargado de depósito (2026-09-09): puede cargar/editar los OBJETIVOS
  // mensuales del ranking de operarios de /deposito (las 3 líneas de
  // referencia del gráfico) sin ser ADMIN. Sólo eso — no cambia qué datos ve
  // ni a qué vistas entra. Lo asigna un admin en /admin/usuarios, columna
  // "Obj. depósito". Ver lib/deposito/objetivoAcceso.ts.
  depositoObjetivoAcceso Boolean @default(false)
  activo         Boolean   @default(true)
  ultimoAcceso   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  legajo         legajo    @relation(fields: [legajoId], references: [id])

  @@index([dni])
  @@schema("everwear")
}

// Mapa editable: qué módulos de la app habilita cada sector.
// `modulos` es un array JSON de claves de módulo (ver lib/auth/modules.ts).
// Sucesión de vendedores: qué códigos de Magnus hereda un vendedor
// (2026-09-08, ver sql/vendedor_antecesor.sql).
//
// /ventas/vendedor, /ventas/bulones y /ventas/faltantes cortan por
// Ven_CompCabecera.vendedor (eje comprobante, el mismo del pivot
// Ventas_Debitos_Creditos). Esta tabla dice qué OTROS códigos suma cada
// vendedor: los de la gente que se fue o cambió de área y cuya cartera
// quedó a su cargo.
//
// antecesorCodigo es UNIQUE a propósito: un código lo hereda UNO SOLO, y
// eso es lo que garantiza que ningún peso se cuente dos veces y que la suma
// de todas las vistas de vendedor dé el total exacto de la empresa.
//
// Es código->código y no usuario->usuario porque el antecesor normalmente
// ya no tiene usuario en la app (existe sólo en MAGNUS_SITD.dbo.Vendedores).
model vendedor_antecesor {
  id              Int      @id @default(autoincrement())
  sucesorCodigo   Int      @map("sucesor_codigo")
  antecesorCodigo Int      @unique @map("antecesor_codigo")
  nota            String?
  creado_en       DateTime @default(now()) @db.Timestamptz(6)

  @@index([sucesorCodigo])
  @@schema("everwear")
}

model sector_permiso {
  id        Int      @id @default(autoincrement())
  sector    String   @unique @db.VarChar(80)
  modulos   Json     @default("[]")
  vistas    Json     @default("[]") // hrefs de sub-vistas permitidas
  ocultos   Json     @default("[]") // keys/hrefs ocultos del inicio (con acceso)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("everwear")
}

// ===== Módulo "sistema": tablero tipo Trello con columnas GLOBALES + vinculación =====
// NOTA: este bloque es de referencia. El flujo real es: correr sql/sistema_init.sql,
// sql/sistema_vinculacion.sql y sql/sistema_columna_historial.sql contra la base y
// después `prisma db pull` (multi-schema no soporta `migrate dev`) — eso reescribe
// este bloque desde la DB real.
// Columnas son globales (las mismas en todos los tableros). Cada tablero oculta las que
// no quiere ver (sistema_columna_oculta). Una tarjeta tiene dueño (tableroId) y un
// vínculo opcional (vinculadoTableroId): si está vinculada aparece en ambos tableros y
// es la MISMA fila, por eso se mueve a la par. Cuenta para el vinculado (orquestado).
model sistema_tablero {
  id            Int                      @id @default(autoincrement())
  clave         String                   @unique @db.VarChar(40)
  nombre        String                   @db.VarChar(100)
  createdAt     DateTime                 @default(now())
  tarjetas      sistema_tarjeta[]        @relation("tarjetaTablero")
  vinculadas    sistema_tarjeta[]        @relation("tarjetaVinculado")
  columnasOcultas sistema_columna_oculta[]

  @@schema("sistema")
}

model sistema_columna {
  id        Int                         @id @default(autoincrement())
  nombre    String                      @unique @db.VarChar(100)
  orden     Int                         @default(0)
  createdAt DateTime                    @default(now())
  tarjetas  sistema_tarjeta[]
  ocultaEn  sistema_columna_oculta[]
  historial sistema_columna_historial[]

  @@schema("sistema")
}

model sistema_columna_oculta {
  tableroId Int
  columnaId Int
  tablero   sistema_tablero @relation(fields: [tableroId], references: [id], onDelete: Cascade)
  columna   sistema_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade)

  @@id([tableroId, columnaId])
  @@schema("sistema")
}

model sistema_tarjeta {
  id                 Int                         @id @default(autoincrement())
  tableroId          Int
  columnaId          Int
  vinculadoTableroId Int?
  orden              Int                         @default(0)
  campos             Json                        @default("{}")
  // Fecha/hora en que la tarjeta entró a su columna actual (se actualiza cada vez que
  // cambia columnaId, sea por drag&drop o por PATCH externo). Usado para autoordenar
  // las columnas sin orden manual — no confundir con createdAt (fecha de alta original).
  columnaDesde       DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  tablero            sistema_tablero             @relation("tarjetaTablero", fields: [tableroId], references: [id], onDelete: Cascade)
  vinculado          sistema_tablero?            @relation("tarjetaVinculado", fields: [vinculadoTableroId], references: [id], onDelete: SetNull)
  columna            sistema_columna             @relation(fields: [columnaId], references: [id], onDelete: Cascade)
  // Recorrido completo: una fila por cada vez que la tarjeta entró a una columna
  // (a diferencia de columnaDesde, que solo guarda la entrada actual).
  historial          sistema_columna_historial[]

  @@index([tableroId])
  @@index([columnaId])
  @@schema("sistema")
}

// Historial de entradas a columna por tarjeta (recorrido completo, no solo la columna
// actual). Se llena automáticamente desde el backend: al crear la tarjeta (columna
// inicial) y cada vez que cambia de columna, sea por drag&drop (reorder) o PATCH directo.
model sistema_columna_historial {
  id        Int             @id @default(autoincrement())
  tarjetaId Int
  columnaId Int
  entradaEn DateTime        @default(now())
  tarjeta   sistema_tarjeta @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  columna   sistema_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade)

  @@index([tarjetaId])
  @@schema("sistema")
}

// Opciones dinámicas para campos tipo "select" de un tablero (ej: categoría, ubicación
// en el tablero "sistema"). El usuario las agrega desde la UI con el botón "+"; se
// guardan por (clave de tablero, nombre de campo) para no pisar otros tableros/campos.
model sistema_opcion {
  id        Int      @id @default(autoincrement())
  clave     String   @db.VarChar(40)
  campo     String   @db.VarChar(50)
  valor     String   @db.VarChar(150)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([clave, campo, valor])
  @@schema("sistema")
}

// ── Puestos + procedimientos/instructivos (RRHH) ──────────────────────────────
// ABM en /rrhh/puestos. Cada documento (procedimiento o instructivo) se asigna
// a uno o más puestos y se indexa en Qdrant (colección "procedimientos") vía
// vicki_chat POST /rag/documento para que Vicki los recupere por RAG.
// Ver sql/rrhh_puestos_documentos.sql — correr contra Postgres + `prisma generate`
// antes de deployar.
model puesto {
  id          Int                @id @default(autoincrement())
  nombre      String             @unique @db.VarChar(120)
  descripcion String?
  sectorId    Int?
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sector      sector?            @relation(fields: [sectorId], references: [id])
  documentos  puesto_documento[]

  @@index([sectorId])
  @@schema("everwear")
}

// tipo: "procedimiento" | "instructivo" | "descripcion_puesto" (ver
// lib/rrhh/documentosTipos.ts). `contenido` es el texto que se indexa en Qdrant;
// `archivoNombre` guarda el adjunto original opcional (en DOCS_DIR, fuera de
// git) y NO se indexa.
// Regla: un puesto puede tener N procedimientos/instructivos pero UNA sola
// descripcion_puesto. Se valida a nivel API (chequearUnicaDescripcion) para no
// requerir migración; si algún día se quiere en la base, va como índice único
// parcial sobre puesto_documento ⨝ documento.tipo='descripcion_puesto'.
model documento {
  id            Int                @id @default(autoincrement())
  tipo          String             @db.VarChar(20)
  titulo        String             @db.VarChar(200)
  contenido     String
  archivoNombre String?            @db.VarChar(200)
  version       Int                @default(1)
  vigente       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  puestos       puesto_documento[]

  @@index([tipo])
  @@schema("everwear")
}

model puesto_documento {
  puestoId    Int
  documentoId Int
  puesto      puesto    @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  documento   documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@id([puestoId, documentoId])
  @@schema("everwear")
}

// ===== Tableros de tareas de RRHH y Compras (duplicados de "sistema") =====
// (2026-08-13): mismo patrón visual/funcional que el tablero
// Trello de "sistema" (ver sistema_tablero/columna/tarjeta más arriba), pero
// un tablero simple por área (sin múltiples tableros ni vinculación entre
// ellos) y con tablas 100% propias — RRHH y Compras gestionan sus propias
// columnas y no comparten datos entre sí ni con sistema_*.
// NOTA: este bloque es de referencia. El flujo real es: correr
// sql/rrhh_tareas.sql y sql/compras_tareas.sql contra la base y después
// `npx prisma generate` (alcanza con generate; no hace falta `db pull` salvo
// que se edite el DDL a mano y se quiera resincronizar este bloque).
model rrhh_tarea_columna {
  id        Int                  @id @default(autoincrement())
  nombre    String               @unique @db.VarChar(100)
  orden     Int                  @default(0)
  createdAt DateTime             @default(now())
  tarjetas  rrhh_tarea_tarjeta[]

  @@schema("everwear")
}

model rrhh_tarea_tarjeta {
  id           Int                @id @default(autoincrement())
  columnaId    Int
  orden        Int                @default(0)
  campos       Json               @default("{}")
  // Fecha/hora en que entró a columnaId actual (se actualiza al cambiar de
  // columna, sea por drag&drop o PATCH externo). No confundir con createdAt.
  columnaDesde DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  columna      rrhh_tarea_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade)

  @@index([columnaId])
  @@schema("everwear")
}

// Config singleton (1 sola fila, clave fija "default"): cómo se acomodan las
// tarjetas dentro de cada columna. POSICION = orden manual (drag&drop, campo
// `orden`). CREACION = automático por fecha de alta. IMPORTANCIA = automático
// por campos.importancia (Alta > Media > Baja). Ver lib/tareas/types.ts.
model rrhh_tarea_config {
  clave         String   @id @default("default") @db.VarChar(20)
  criterioOrden String   @default("POSICION") @db.VarChar(20)
  updatedAt     DateTime @updatedAt

  @@schema("everwear")
}

model compras_tarea_columna {
  id        Int                     @id @default(autoincrement())
  nombre    String                  @unique @db.VarChar(100)
  orden     Int                     @default(0)
  createdAt DateTime                @default(now())
  tarjetas  compras_tarea_tarjeta[]

  @@schema("everwear")
}

model compras_tarea_tarjeta {
  id           Int                   @id @default(autoincrement())
  columnaId    Int
  orden        Int                   @default(0)
  campos       Json                  @default("{}")
  columnaDesde DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  columna      compras_tarea_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade)

  @@index([columnaId])
  @@schema("everwear")
}

model compras_tarea_config {
  clave         String   @id @default("default") @db.VarChar(20)
  criterioOrden String   @default("POSICION") @db.VarChar(20)
  updatedAt     DateTime @updatedAt

  @@schema("everwear")
}
// Accesos directos que cada usuario marcó con la estrella en la sidebar
// ("Mis accesos"). DDL a mano en sql/usuario_acceso.sql; acá sólo el modelo
// para Prisma (`npx prisma generate` después de correr el SQL).
// Es preferencia, no permiso: el catálogo marcable ya viene filtrado por los
// permisos de la sesión en app/api/preferencias/accesos/route.ts.
model usuario_acceso {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  href      String   @db.VarChar(200)
  label     String   @db.VarChar(120)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([usuarioId, href])
  @@index([usuarioId])
  @@schema("everwear")
}

// Presupuesto APROBADO por área de compras (pestaña "Presupuestos" de
// /finanza). Lo ejecutado sale de Magnus (OC por tipo de comprobante); esto es
// el techo contra el que se compara. DDL a mano en
// sql/finanza_presupuesto_area.sql; acá sólo el modelo para Prisma
// (`npx prisma generate` después de correr el SQL).
// `monto` está en PESOS (en la pantalla se carga en millones y la API
// multiplica). El período es un rango de meses inclusive 'YYYY-MM'.
model finanza_presupuesto_area {
  id         Int      @id @default(autoincrement())
  codigoArea Int
  area       String   @db.VarChar(120)
  mesDesde   String   @db.Char(7)
  mesHasta   String   @db.Char(7)
  monto      Decimal  @db.Decimal(18, 2)
  nota       String?  @db.VarChar(200)
  creadoPor  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([codigoArea, mesDesde, mesHasta])
  @@index([mesHasta, mesDesde])
  @@schema("everwear")
}

// Objetivos mensuales del ranking de operarios de /deposito (pestañas Picking,
// Libre + Reposición y Re-Ubicación). Son las 3 líneas de referencia que se
// dibujan sobre las barras: `objetivo` (verde), `sobresaliente` (amarilla) y
// `bajo` (roja). DDL a mano en sql/deposito_objetivo.sql; acá sólo el modelo
// para Prisma (`npx prisma generate` después de correr el SQL).
// Los tres valores están en ITEMS aunque en la pantalla se carguen en MILES:
// la API multiplica al escribir. Uno por proceso y mes ('YYYY-MM').
// Registro de trabajo de embolsado — /deposito/embolsado (ver
// sql/deposito_embolsado.sql). La recomendación NO se guarda (se calcula en
// vivo contra Magnus + WMS); acá queda quién embolsó qué, cuándo empezó,
// cuándo terminó y cuántas unidades salieron, más una foto de la
// recomendación del momento en que tomó el ítem.
//
// Quién embolsa se identifica con el USUARIO DE MAGNUS (Gen_Usuarios) cada vez
// que toma un ítem: la pantalla la comparten varias personas en una sola PC y
// la sesión de la app no dice quién está parado ahí. `usuarioMagnus` es el
// Numero (identidad estable) y `embolsador` el nombre canónico del maestro.
//
// Los dos candados de "un ítem por persona / una persona por ítem" son
// índices ÚNICOS PARCIALES (WHERE fin IS NULL) y viven en el SQL: Prisma no
// sabe declararlos y `db push` no los toca. No agregarlos acá como @@unique,
// que impediría repetir un artículo o una persona en el histórico.
model deposito_embolsado {
  id              Int       @id @default(autoincrement())
  codArticulo     String    @db.VarChar(20)
  nombre          String    @default("") @db.VarChar(160)
  empaque         String    @default("") @db.VarChar(40)
  usuarioMagnus   Int
  embolsador      String    @db.VarChar(60)
  inicio          DateTime  @default(now())
  fin             DateTime?
  cantidad        Int?
  recomendado     Int?
  ventaMaxMes     Int?
  stockSinIngreso Int?
  enIngreso       Int?
  creadoPor       Int?

  @@index([inicio(sort: Desc)])
  @@index([usuarioMagnus, inicio(sort: Desc)])
  @@schema("everwear")
}

model deposito_objetivo {
  id            Int      @id @default(autoincrement())
  proceso       String   @db.VarChar(40)
  mes           String   @db.Char(7)
  objetivo      Int
  sobresaliente Int?
  bajo          Int?
  creadoPor     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // La UNIQUE ya crea el btree (proceso, mes) que usan todas las lecturas
  // (por proceso + rango de meses): no hace falta un índice aparte.
  @@unique([proceso, mes])
  @@schema("everwear")
}

// Objetivos de venta por VENDEDOR, LÍNEA y MES — pestaña "Pulso" de
// /ventas/bulones. Una fila por mes: un objetivo "de 6 meses" son 6 filas, así
// el objetivo de cualquier rango es una suma y se puede corregir un mes suelto.
// `objetivo` está en PESOS aunque la pantalla lo cargue en MILES (la API
// multiplica al escribir). DDL a mano en sql/ventas_objetivo.sql; acá sólo el
// modelo para Prisma (`npx prisma generate` después de correr el SQL).
model ventas_objetivo {
  id        Int      @id @default(autoincrement())
  linea     String   @db.VarChar(30)
  vendedor  Int
  mes       String   @db.Char(7)
  objetivo  BigInt
  creadoPor Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La UNIQUE arranca por (linea, vendedor); la lectura de la pantalla es por
  // línea + rango de meses para TODOS los vendedores de una vez, y esa la
  // cubre el índice de abajo.
  @@unique([linea, vendedor, mes])
  @@index([linea, mes])
  @@schema("everwear")
}

// Escala de premios por errores — modal "Márgenes" de /rrhh/premios. Cada fila
// es una VERSIÓN de la escala de un ámbito ('preparado' | 'mesa') que rige
// DESDE `vigencia` (YYYY-MM) en adelante, hasta que exista otra posterior: la
// escala de un mes M es la fila con el `vigencia` más alto <= M, así cambiar
// los tramos no toca lo ya liquidado. `tramos` = [{desde, hasta|null,
// descuento}] (% del premio que se resta). DDL a mano en
// sql/rrhh_premio_escala.sql; acá sólo el modelo para Prisma
// (`npx prisma generate` después de correr el SQL).
model premio_escala {
  id        Int      @id @default(autoincrement())
  ambito    String   @db.VarChar(12)
  vigencia  String   @db.Char(7)
  tramos    Json
  creadoPor Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Única lectura que existe: todas las versiones de un ámbito ordenadas por
  // vigencia — la cubre el btree que ya crea la UNIQUE.
  @@unique([ambito, vigencia])
  @@schema("everwear")
}
